CORS_ORIGINS=http://localhost:5173
# Free-tier TinyFish key from https://agent.tinyfish.ai (never commit the real key)
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai
TINYFISH_TIMEOUT_S=120
# If live retrieval fails, return the labelled demo product instead of an error
ALLOW_DEMO_FALLBACK=true

# Supabase Postgres (never commit real values). DATABASE_URL is the direct or pooler connection string,
# for example postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=
# Not used by the code yet (asyncpg connects with DATABASE_URL); reserved for a later Supabase client.
SUPABASE_URL=
SUPABASE_KEY=
# Signs the session cookie. At least 32 characters; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
